#!/bin/sh
set -e

VERSION="1.0.0"

# Detect existing registrations dynamically
OLD_VERSIONS=$(dkms status -m rtl8189fs 2>/dev/null | awk -F'[/,]' '{print $2}' | sort -u)

if [ -n "$OLD_VERSIONS" ]; then
    for VER in $OLD_VERSIONS; do
        if [ "$VER" != "$VERSION" ]; then
            echo "Terdeteksi driver rtl8189fs versi lama ($VER), mencopot versi lama..."
            dkms remove -m rtl8189fs -v "$VER" --all 2>/dev/null || true
        fi
    done
else
    echo "Instalasi bersih terdeteksi (belum ada versi lama di sistem)."
fi

echo "Registering rtl8189fs ($VERSION) with DKMS..."
dkms remove -m rtl8189fs -v $VERSION --all 2>/dev/null || true
dkms add -m rtl8189fs -v $VERSION

# Check if kernel header host tools (modpost) match system glibc, self-heal directly if needed
KERNEL_BUILD_DIR="/lib/modules/$(uname -r)/build"
MODPOST_BIN="${KERNEL_BUILD_DIR}/scripts/mod/modpost"
MOD_DIR="${KERNEL_BUILD_DIR}/scripts/mod"
if [ -d "$KERNEL_BUILD_DIR" ] && [ -d "$MOD_DIR" ]; then
    if [ -f "$MODPOST_BIN" ] && ! "$MODPOST_BIN" -h >/dev/null 2>&1; then
        echo "Menyelaraskan toolchain header kernel (rebuilding modpost untuk glibc lokal)..."
        EXTRA_SRCS=""
        [ -f "${MOD_DIR}/symsearch.c" ] && EXTRA_SRCS="${MOD_DIR}/symsearch.c"
        gcc -O2 -std=gnu11 -I "${KERNEL_BUILD_DIR}/scripts/include" -o "$MODPOST_BIN" \
            "${MOD_DIR}/modpost.c" \
            "${MOD_DIR}/file2alias.c" \
            "${MOD_DIR}/sumversion.c" \
            $EXTRA_SRCS >/dev/null 2>&1 || true
    fi
fi

echo "Building & installing rtl8189fs ($VERSION) via DKMS..."
dkms build -m rtl8189fs -v $VERSION
dkms install -m rtl8189fs -v $VERSION

echo "Configuring automatic kernel module loading..."
echo 8189fs > /etc/modules-load.d/rtl8189fs.conf
depmod -a

# Ensure cfg80211 subsystem dependency is loaded
modprobe cfg80211 2>/dev/null || true

# Load driver module
modprobe 8189fs 2>/dev/null || true

ip link set wlan0 up 2>/dev/null || true

# Apply sysctl and udev performance rules (IRQ balancing & RPS)
if [ -f /etc/sysctl.d/99-rtl8189fs-throughput.conf ]; then
    sysctl -p /etc/sysctl.d/99-rtl8189fs-throughput.conf 2>/dev/null || true
fi
udevadm control --reload-rules 2>/dev/null || true
udevadm trigger 2>/dev/null || true
if [ -x /usr/lib/udev/rtl8189fs-irq-tune.sh ]; then
    /usr/lib/udev/rtl8189fs-irq-tune.sh 2>/dev/null || true
fi

systemctl restart wpa_supplicant 2>/dev/null || true
systemctl restart NetworkManager 2>/dev/null || true

echo "rtl8189fs driver v${VERSION} installed successfully!"
